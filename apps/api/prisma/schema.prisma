// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Phase 0 scope only: just enough of Section 10's core entities to prove
// tenant isolation end-to-end. Full entity set (Wallet, ledger, rule engine,
// claims, etc.) is Phase 1 — see docs/requirements §10/§11/§12/§24.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// The login identity — deliberately NOT tenant-scoped (Section 7's
// identity-vs-membership split). One Account can hold Memberships in
// multiple Organisations.
model Account {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  passwordHash String
  // Identity-level, not per-Member — set once when the Account is first
  // created (register-organisation or a first-time join-organisation) and
  // carries through every org this Account later joins. Nullable at the
  // DB level only to avoid a backfill migration for accounts that predate
  // this field; application code treats it as required going forward
  // (AuthService rejects account creation without one) and the mobile app
  // hard-gates any pre-existing account without one behind a
  // complete-your-profile screen before it can reach the rest of the app.
  name         String?
  createdAt    DateTime @default(now())

  members Member[]

  @@map("accounts")
}

// The tenant. Every tenant-scoped table carries an organisationId FK back
// to this and is protected by a Postgres RLS policy keyed on it.
model Organisation {
  id        String   @id @default(uuid())
  legalName String
  type      String
  country   String   @default("GH")
  currency  String   @default("GHS")
  status    String   @default("trial")
  createdAt DateTime @default(now())

  // A short, human-shareable alternative to the UUID above — generated at
  // registration (see AuthService.registerOrganisation), so a member can
  // actually be handed something readable to join with instead of a raw
  // UUID typed by hand. The UUID id itself is still the real key
  // everything else in the schema references; this is purely a friendly
  // lookup alias, resolved to the real id at the start of joinOrganisation.
  joinCode String @unique

  // FR-LEDGER-07: how an incoming payment is applied across a member's open
  // Obligations. Only 'oldest_first' is actually implemented by
  // LedgerService right now — see the note on ObligationService — but the
  // field accepts the full spec vocabulary so choosing another value
  // doesn't need a migration later, just an implementation.
  paymentAllocationPolicy String @default("oldest_first")

  // §13.1: "an optional but recommended constraint per tenant, not a
  // hardcoded universal rule, since some very small groups genuinely have
  // only one active officer." Off by default for exactly that reason.
  makerCheckerEnabled Boolean @default(false)

  members                  Member[]
  chapters                 Chapter[]
  contributionPlans        ContributionPlan[]
  benefitRules             BenefitRule[]
  funds                    Fund[]
  ledgerAccounts           LedgerAccount[]
  journalEntries           JournalEntry[]
  obligations              Obligation[]
  paymentIntents           PaymentIntent[]
  reconciliationExceptions ReconciliationException[]
  roles                    Role[]
  roleAssignments          RoleAssignment[]
  claims                   Claim[]
  defaulterPolicy          DefaulterPolicy?
  governanceBodies         GovernanceBody[]
  notifications            Notification[]
  subscription             Subscription?
  budgets                  Budget[]

  @@map("organisations")
}

// Optional sub-grouping within a tenant (FR-MEM-04's "chapters/campuses").
// Most Phase 1 tenants won't use this — chapterId on Member stays nullable.
model Chapter {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())

  organisation      Organisation       @relation(fields: [organisationId], references: [id])
  members           Member[]
  contributionPlans ContributionPlan[]
  benefitRules      BenefitRule[]
  roleAssignments   RoleAssignment[]

  @@index([organisationId])
  @@map("chapters")
}

// FR-MEM-01. Deliberately no automatic transition logic here — the
// "configurable per tenant entry/exit conditions" the spec asks for is rule
// engine territory (§11, Phase 1 roadmap slice 3), not yet built. This slice
// only adds the states themselves plus an explicit, audited way to move a
// Member between them (MemberStatusChange) — the engine will drive those
// transitions automatically once it exists; nothing here needs to change
// when it does.
enum MemberStatus {
  PENDING
  PROBATION
  ACTIVE
  GRACE
  DEFAULTER
  SUSPENDED
  EXITED
  DECEASED
}

// Superseded by RoleAssignment (§13, roadmap slice 6) as the actual
// authorization source — access.util.ts's requireAdmin/requireSelfOrAdmin
// now run a live RbacService check, never trusting this field or the
// AuthTokenPayload.role JWT claim derived from it. Kept only so the
// founding-admin-vs-joiner distinction stays visible on the row itself and
// the JWT shape stays stable for existing callers; not read for any
// access-control decision anymore.
enum MemberRole {
  ADMIN
  MEMBER
}

// Belongs to one Account and one Organisation (Section 10). Tenant-scoped:
// protected by RLS on organisationId, *and* independently readable by the
// owning Account via a separate account-scoped policy (see the
// add_member_role_and_account_policy migration) — logging in needs to look
// up "which orgs is this account a member of" before any tenant context
// exists, the same bootstrapping problem Organisation creation had.
model Member {
  id             String       @id @default(uuid())
  accountId      String
  organisationId String
  chapterId      String?
  role           MemberRole   @default(MEMBER)
  // FR-MEM-07: categories ineligible for contribution/benefit (e.g. contract
  // staff) without needing a separate tenant. Free-form per-tenant string
  // for now — the rule engine (§11) is what will actually read this to gate
  // eligibility; this slice just makes sure the field exists on every row.
  category       String       @default("standard")
  joinDate       DateTime     @default(now())
  status         MemberStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  // A monthly-plan payment that overshoots the last obligation this
  // service will auto-generate for (see ObligationService's
  // MAX_MONTHLY_EXTENSION safety cap) parks the remainder here instead of
  // being rejected — swept back in at the start of that member's next
  // payment. Never touched for one-time/event plans, only the recurring
  // monthly-waterfall path. See recordContributionPaymentInTx.
  creditBalance  Decimal      @default(0) @db.Decimal(12, 2)

  account         Account                @relation(fields: [accountId], references: [id])
  organisation    Organisation           @relation(fields: [organisationId], references: [id])
  chapter         Chapter?               @relation(fields: [chapterId], references: [id])
  dependants      Dependant[]
  statusChanges   MemberStatusChange[]
  removalRequests MemberRemovalRequest[]
  obligations     Obligation[]
  paymentIntents  PaymentIntent[]
  roleAssignments RoleAssignment[]
  claims          Claim[]
  notifications   Notification[]

  @@index([organisationId])
  @@index([accountId])
  @@map("members")
}

// FR-MEM-03: first-class, pre-registered, time-stamped dependant/beneficiary
// records, so a bereavement claim can later be checked against a name
// registered *before* the event. organisationId is denormalized from
// Member.organisationId (rather than an RLS policy that joins through
// Member) purely so this table can use the exact same simple, fast
// tenant_isolation policy shape as every other tenant-scoped table.
model Dependant {
  id             String   @id @default(uuid())
  memberId       String
  organisationId String
  relationship   String
  name           String
  registeredAt   DateTime @default(now())
  // FR-MEM-10: a dependant copied over when an existing Account joins a
  // *second* organisation starts unconfirmed — it must be explicitly
  // re-confirmed before that org's claims can treat it as pre-registered.
  // Dependants entered directly (the common case) are confirmed immediately.
  confirmed      Boolean  @default(true)

  member Member  @relation(fields: [memberId], references: [id])
  claims Claim[]

  @@index([organisationId])
  @@index([memberId])
  @@map("dependants")
}

// FR-RULE-01/02: every contribution obligation and benefit entitlement is a
// versioned, effective-dated, tenant-scoped configuration record — never
// deleted or overwritten. Deliberately NOT a separate RuleVersion table
// wrapping these: the spec's own worked examples (§11.2/11.3) put
// effective_from/supersedes/created_by/approved_by directly on the rule
// object itself, so each row here already *is* one immutable version; an
// amendment is a new row with supersedesId pointing at the one it replaces,
// not an edit. RuleStatus is shared by both rule types.
enum RuleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REJECTED
}

// FR-LED-01/02: what a member owes. Phase 1 scope: fixed-amount only
// (computationType exists as a field so a future percentage/formula type
// doesn't need a migration, but only "fixed" is actually evaluated —
// RuleEngineService throws rather than silently mis-computing anything
// else). Eligibility is flattened onto the rule itself (minTenureMonths,
// goodStandingRequired) rather than a separate EligibilityRule table,
// matching the same worked-examples reasoning as above.
model ContributionPlan {
  id                               String     @id @default(uuid())
  organisationId                   String
  chapterId                        String?
  name                             String
  cadence                          String // "monthly" | "one_time" | "event_triggered" — free-form per tenant for now
  computationType                  String     @default("fixed")
  amountValue                      Decimal    @db.Decimal(12, 2)
  currency                         String
  collectionMechanism              String     @default("push") // "push" | "payroll" (FR-LED-02)
  // Which Fund a payment against this plan should default to, on either
  // the admin's record-payment form or a member's own pay screen — so a
  // routine monthly-dues payment isn't left to whichever fund happened to
  // be selected (or first in the list), including a one-off collection
  // fund it was never meant to land in. A suggestion the picker
  // pre-selects, not a hard constraint — an admin can still override it.
  defaultFundId                    String?
  // FR-LEDGER-06: "grace period" is at least four different things the
  // source constitutions conflate under one term. minTenureMonths above is
  // the *benefit* waiting period (a BenefitRule concern — UDS's 6-month
  // rule). The three below are the contribution-side ones, independently
  // configurable, deliberately not merged into one field:
  //   - joiningGracePeriodDays: before a new member owes anything at all
  //   - paymentGracePeriodDays: extra days after a due date before OVERDUE
  //   - reinstatementWaitingPeriodMonths: after clearing arrears, before
  //     benefits resume (a fresh probation, per AGAOSAS)
  joiningGracePeriodDays           Int?
  paymentGracePeriodDays           Int?
  reinstatementWaitingPeriodMonths Int?
  // FR-COM-01: "configurable reminders ahead of a contribution due date."
  // Unset (the default) means no reminder — opt-in per plan, same reasoning
  // as DefaulterPolicy/makerCheckerEnabled. Read by
  // NotificationSchedulerService's daily sweep, not evaluated anywhere else.
  reminderDaysBeforeDue            Int?
  minTenureMonths                  Int?
  goodStandingRequired             Boolean    @default(true)
  beneficiaryMemberIds             String[]   @default([])
  status                           RuleStatus @default(DRAFT)
  effectiveFrom                    DateTime?
  effectiveTo                      DateTime?
  supersedesId                     String?    @unique
  createdBy                        String // Member.id of the admin who created this version
  approvedBy                       String?
  createdAt                        DateTime   @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  chapter      Chapter?          @relation(fields: [chapterId], references: [id])
  defaultFund  Fund?             @relation(fields: [defaultFundId], references: [id])
  supersedes   ContributionPlan? @relation("ContributionPlanVersions", fields: [supersedesId], references: [id])
  supersededBy ContributionPlan? @relation("ContributionPlanVersions")
  obligations  Obligation[]

  @@index([organisationId])
  @@map("contribution_plans")
}

// FR-RULE-04, FR-MEM-03's counterpart on the entitlement side: what a
// member/dependant is entitled to when a trigger event occurs. occurrenceCap
// is now enforced by RuleEngineService.evaluateBenefitEligibility (roadmap
// slice 7, Claims) by counting a member+dependant's prior non-rejected
// Claims against this exact rule row — only occurrenceCapScope "lifetime"
// is implemented, same "fail loudly rather than silently mis-evaluate"
// pattern as computationType/paymentAllocationPolicy elsewhere. approvalChain
// is the ordered list of stage names ClaimService walks a Claim through.
model BenefitRule {
  id                          String     @id @default(uuid())
  organisationId              String
  chapterId                   String?
  name                        String
  triggerEvent                String // e.g. "member.birth", "dependant.death"
  subjectTypes                String[] // e.g. ["self"] or ["spouse","child","parent"]
  amountValue                 Decimal    @db.Decimal(12, 2)
  currency                    String
  occurrenceCapScope          String     @default("lifetime")
  occurrenceCapMax            Int
  minTenureMonths             Int?
  goodStandingRequired        Boolean    @default(true)
  maxConsecutiveMissedPeriods Int?
  evidenceRequired            String[]
  approvalChain               String[]
  status                      RuleStatus @default(DRAFT)
  effectiveFrom               DateTime?
  effectiveTo                 DateTime?
  supersedesId                String?    @unique
  createdBy                   String
  approvedBy                  String?
  createdAt                   DateTime   @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  chapter      Chapter?     @relation(fields: [chapterId], references: [id])
  supersedes   BenefitRule? @relation("BenefitRuleVersions", fields: [supersedesId], references: [id])
  supersededBy BenefitRule? @relation("BenefitRuleVersions")
  claims       Claim[]

  @@index([organisationId])
  @@map("benefit_rules")
}

// §12.1: every Fund owns its own chart of accounts. Most Phase 1 tenants
// will have exactly one ("General Welfare Fund"), but §12.2 explicitly
// requires supporting a single contribution split across several.
model Fund {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())

  organisation    Organisation       @relation(fields: [organisationId], references: [id])
  ledgerAccounts  LedgerAccount[]
  journalEntries  JournalEntry[]
  paymentIntents  PaymentIntent[]
  defaultForPlans ContributionPlan[]

  @@index([organisationId])
  @@map("funds")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

// §12.1's chart-of-accounts categories (cash/bank/mobile-money under
// ASSET; benefits payable and member advance-payment credits under
// LIABILITY; contributions/donations under INCOME; benefits paid under
// EXPENSE). Named LedgerAccount, not Account, to avoid any confusion with
// the login-identity `Account` model (Section 7) — completely unrelated
// concepts that happen to share the word "account" in English.
//
// memberId is nullable and mostly unused in Phase 1: it's here so a
// member's wallet (FR-LED-07/08) can eventually be modelled as their own
// LIABILITY account without a schema change, per the spec's explicit
// Phase 1 scope of "the wallet's liability-account *data model*" only —
// the top-up feature itself is Phase 2, and nothing in this slice creates
// or uses one yet.
model LedgerAccount {
  id               String            @id @default(uuid())
  organisationId   String
  fundId           String
  memberId         String?
  type             LedgerAccountType
  name             String
  // Only meaningful for type EXPENSE — an admin-created custom expense
  // account explicitly flagged as administrative overhead, distinct from
  // Benefits Expense. Reporting Phase C's Financial Health ratios
  // (expenseRatio/administrativeCostRatio) sum only accounts flagged here
  // rather than guessing by account name — see ReportingService.
  isAdministrative Boolean           @default(false)
  createdAt        DateTime          @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  fund         Fund          @relation(fields: [fundId], references: [id])
  journalLines JournalLine[]
  budgets      Budget[]

  @@index([organisationId])
  @@index([fundId])
  @@map("ledger_accounts")
}

// §12.2, FR-LEDGER-01/02: every financial event posts exactly one
// JournalEntry made of balanced JournalLines (sum(debit) = sum(credit)),
// checked in LedgerService.postJournalEntry before insert — not by a DB
// trigger, a deliberate simplicity-over-belt-and-braces tradeoff for this
// slice. Once posted, never updated or deleted at the application layer;
// LedgerService exposes no update/delete method at all, only
// reverseJournalEntry (a new contra JournalEntry referencing this one via
// reversalOfId — the correction, not an edit).
//
// sourceType/sourceId are a lightweight, un-enforced pointer to whatever
// triggered this entry (e.g. sourceType "contribution_payment", sourceId an
// Obligation id) — free-form rather than a real FK because the set of
// possible sources grows with every future slice (Claims' disbursements,
// eventually Payments' provider webhooks) and most of those don't exist
// yet.
model JournalEntry {
  id             String   @id @default(uuid())
  organisationId String
  fundId         String
  description    String
  sourceType     String?
  sourceId       String?
  reversalOfId   String?
  postedAt       DateTime @default(now())
  createdBy      String // Member.id

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  fund          Fund           @relation(fields: [fundId], references: [id])
  reversalOf    JournalEntry?  @relation("JournalEntryReversals", fields: [reversalOfId], references: [id])
  reversals     JournalEntry[] @relation("JournalEntryReversals")
  lines         JournalLine[]
  paymentIntent PaymentIntent?
  claim         Claim?

  @@index([organisationId])
  @@index([fundId])
  @@map("journal_entries")
}

// Exactly one of debit/credit is non-zero per line — validated in
// LedgerService, same reasoning as the entry-level balance check above.
// obligationId is set when this line is (part of) settling a specific
// Obligation, so a payment's allocation across multiple open obligations
// (FR-LEDGER-07) is traceable per line, not just as a lump sum.
model JournalLine {
  id              String  @id @default(uuid())
  journalEntryId  String
  organisationId  String
  ledgerAccountId String
  memberId        String?
  obligationId    String?
  debit           Decimal @default(0) @db.Decimal(12, 2)
  credit          Decimal @default(0) @db.Decimal(12, 2)

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  obligation    Obligation?   @relation(fields: [obligationId], references: [id])

  @@index([organisationId])
  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@index([obligationId])
  @@map("journal_lines")
}

// Advanced reporting Phase B, §9: budget management by Income/Expense
// Category — those categories already exist as real ledger accounts (no
// new "category" concept needed), so a Budget is just a target amount for
// one account over one period. No fundId: a LedgerAccount already belongs
// to exactly one Fund, so fund-scoping falls out for free. "Actual" is
// never stored here — always computed fresh from JournalLine at read
// time (BudgetService.listWithActuals), same "never a stored,
// independently-editable number" principle as every ledger balance.
model Budget {
  id              String   @id @default(uuid())
  organisationId  String
  ledgerAccountId String
  name            String?
  periodStart     DateTime
  periodEnd       DateTime
  amountValue     Decimal  @db.Decimal(12, 2)
  createdBy       String
  createdAt       DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([organisationId])
  @@index([ledgerAccountId])
  @@map("budgets")
}

// §12.4: obligation status is its own field, distinct from any payment — a
// late payment settles the obligation financially without rewriting
// whether it was originally on time; dueDate never changes once created.
enum ObligationStatus {
  UPCOMING
  DUE
  PAID
  PARTIALLY_PAID
  OVERDUE
  DEFAULTED
  WAIVED
  EXEMPTED
  WRITTEN_OFF
  CANCELLED
}

// What a specific member owes for a specific period, per a ContributionPlan
// — the persisted record that RuleEngineService.computeContributionObligation
// (roadmap slice 3) feeds into. amountPaid is a running total updated as
// JournalLines settle against this obligation; it is a convenience read,
// not the source of truth — the source of truth is always the sum of
// JournalLines referencing this obligation (same FR-LEDGER-05 principle
// applied one level down from fund balances).
model Obligation {
  id                 String           @id @default(uuid())
  organisationId     String
  memberId           String
  contributionPlanId String
  dueDate            DateTime
  amountValue        Decimal          @db.Decimal(12, 2)
  currency           String
  amountPaid         Decimal          @default(0) @db.Decimal(12, 2)
  status             ObligationStatus @default(UPCOMING)
  createdAt          DateTime         @default(now())

  organisation     Organisation     @relation(fields: [organisationId], references: [id])
  member           Member           @relation(fields: [memberId], references: [id])
  contributionPlan ContributionPlan @relation(fields: [contributionPlanId], references: [id])
  journalLines     JournalLine[]

  @@index([organisationId])
  @@index([memberId])
  @@index([contributionPlanId])
  @@map("obligations")
}

enum PaymentChannel {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum PaymentIntentStatus {
  INITIATED
  SUCCEEDED
  FAILED
}

// §15, FR-PAY-01/04. A real payment is asynchronous: initiating one only
// gets a providerReference, not a result — the provider confirms
// success/failure later via webhook, which is what actually posts the
// ledger entry (see PaymentService.handleWebhook). This row is what makes
// that webhook idempotent: "the second delivery is a no-op, never a
// double-post" only works because there's a durable, providerReference-
// keyed record of what's already been processed.
model PaymentIntent {
  id                String              @id @default(uuid())
  organisationId    String
  memberId          String
  fundId            String
  channel           PaymentChannel
  amountValue       Decimal             @db.Decimal(12, 2)
  currency          String
  // Only populated when the org's paymentAllocationPolicy is
  // 'member_selected' — captured at initiate time so the choice survives
  // until the webhook confirms the payment and actually posts it, since a
  // real payment is asynchronous (see initiateContributionPayment). Empty
  // for every 'oldest_first' org, which is still the default.
  obligationIds     String[]            @default([])
  // Globally unique, not just per-tenant — this is the provider's own
  // transaction id, and providers don't know about our tenant boundaries.
  providerReference String              @unique
  status            PaymentIntentStatus @default(INITIATED)
  journalEntryId    String?             @unique
  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  member       Member        @relation(fields: [memberId], references: [id])
  fund         Fund          @relation(fields: [fundId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([organisationId])
  @@map("payment_intents")
}

// FR-PAY-04: "surface unreconciled transactions to the Treasurer" — the
// system never auto-corrects a mismatch on its own (§12.3). Created when a
// webhook arrives whose providerReference doesn't match any known
// PaymentIntent for the organisation it claims, or reports a status that
// conflicts with one already recorded (e.g. "succeeded" for an intent this
// system already marked FAILED) — never silently overwritten.
model ReconciliationException {
  id                String    @id @default(uuid())
  organisationId    String
  providerReference String
  reason            String
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@map("reconciliation_exceptions")
}

// §13.1: a Permission is a (resource, action, scope) triple. Kept as a
// JSON array on Role rather than a normalized Permission catalog table —
// the action vocabulary is explicitly open-ended and parameterized
// (`approve_stage:<n>` for an arbitrary claim-approval stage), so a fixed
// enum/catalog would either be incomplete or need constant migrations.
// Shape (documented, not DB-enforced): { resource: string, action: string,
// scope: "own" | "chapter" | "organisation" }[] — see RbacService.
model Role {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  // True for the 7 starter templates seeded per §13.2 (Org Admin,
  // Treasurer, Committee Chair, Convener, Patron, Auditor, Member) —
  // informational only; templates aren't otherwise special-cased, so a
  // tenant can freely clone or diverge from one without any code change.
  isTemplate     Boolean  @default(false)
  permissions    Json
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  assignments  RoleAssignment[]

  @@index([organisationId])
  @@map("roles")
}

// Member x Role x optional Chapter scope x term (§13.1) — "the same person
// can be Convener for one chapter and an ordinary Member everywhere else"
// is two separate rows, not a field on Member. termEnd is what makes
// FR-AUD-01's time-boxed Auditor role possible: set it at assignment time
// and the grant simply stops counting in RbacService.hasPermission once
// it's passed. Revoking an open-ended assignment early sets termEnd rather
// than deleting the row — "member X held role Y from date A to date B" is
// a historical fact worth keeping, same reasoning as MemberStatusChange.
//
// governanceBodyId (roadmap: Governance, §8.3) mirrors chapterId exactly,
// matching the spec's own data-model line: "RoleAssignment links Member x
// Role x Governance Body." Each row here already *is* one term of office —
// no separate "Term" table — GovernanceService.appointOfficer reads a
// member's own prior rows for a (role, governanceBody) pair to enforce
// FR-GOV-02's term limits/cooling-off, the same "each row is a version"
// reasoning ContributionPlan/BenefitRule use. Deliberately NOT exposed on
// the generic POST /roles/:id/assignments endpoint/AssignRoleDto — only
// GovernanceService.appointOfficer (which enforces term limits) can set
// it, so there's no bypass route around that check.
model RoleAssignment {
  id               String    @id @default(uuid())
  organisationId   String
  memberId         String
  roleId           String
  chapterId        String?
  governanceBodyId String?
  termStart        DateTime  @default(now())
  termEnd          DateTime?
  createdAt        DateTime  @default(now())

  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  member         Member          @relation(fields: [memberId], references: [id])
  role           Role            @relation(fields: [roleId], references: [id])
  chapter        Chapter?        @relation(fields: [chapterId], references: [id])
  governanceBody GovernanceBody? @relation(fields: [governanceBodyId], references: [id])

  @@index([organisationId])
  @@index([memberId])
  @@index([roleId])
  @@index([governanceBodyId])
  @@map("role_assignments")
}

// §8.3, FR-GOV-01/02, Phase 1 scope only per the roadmap table:
// governance bodies, term limits, role vacancy handling. FR-GOV-03/04
// (motions/minutes/votes, "vote of no confidence") are explicitly Phase 2
// — "officers can be recorded administratively at first; full governance
// workflow isn't on the path to proving the contribution/benefit loop."
// membershipCompositionRule/quorumRule/tieBreakRule/meetingCadence are
// free-form strings, not a structured formula — nothing in Phase 1
// evaluates them (no Meeting/Motion model exists yet to check a quorum
// against), same "captured as data, not yet enforced" pattern as
// BenefitRule.occurrenceCap before the Claims slice existed to consume it.
// maxConsecutiveTerms/coolingOffPeriodMonths, by contrast, ARE enforced —
// see GovernanceService.appointOfficer — because FR-GOV-02 lists term
// limits as in-scope now, not deferred.
model GovernanceBody {
  id                        String   @id @default(uuid())
  organisationId            String
  name                      String
  membershipCompositionRule String?
  quorumRule                String?
  tieBreakRule              String?
  meetingCadence            String?
  maxConsecutiveTerms       Int?
  coolingOffPeriodMonths    Int?
  createdAt                 DateTime @default(now())

  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  roleAssignments RoleAssignment[]

  @@index([organisationId])
  @@map("governance_bodies")
}

// Audit trail for every MemberStatus transition (§8.12 — audit is
// non-negotiable from day one, not something to retrofit later; this is
// this slice's contribution to that, same principle as RLS being
// foundational since Phase 0). organisationId denormalized for RLS, same
// reasoning as Dependant.
model MemberStatusChange {
  id             String        @id @default(uuid())
  memberId       String
  organisationId String
  fromStatus     MemberStatus?
  toStatus       MemberStatus
  reason         String?
  // The acting admin's Member id. No Prisma @relation (would be a second,
  // ambiguous FK onto Member alongside `memberId`) — same reasoning as
  // ClaimStageAction.actorMemberId. Nullable only because rows created
  // before this field existed have no value to backfill.
  changedBy      String?
  changedAt      DateTime      @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([organisationId])
  @@index([memberId])
  @@map("member_status_changes")
}

// §13.1 maker-checker, extended to member removal: a status change *to*
// EXITED, when the org has makerCheckerEnabled on, doesn't apply
// immediately — it sits here until a *different* admin confirms it. Member.
// status is untouched until CONFIRMED, so nothing else that reads
// MemberStatus (rule engine, defaulter checks, governance vacancy logic)
// needs to know this intermediate state exists at all.
enum MemberRemovalRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model MemberRemovalRequest {
  id             String                     @id @default(uuid())
  memberId       String
  organisationId String
  requestedBy    String
  reason         String
  status         MemberRemovalRequestStatus @default(PENDING)
  requestedAt    DateTime                   @default(now())
  confirmedBy    String?
  confirmedAt    DateTime?
  cancelledBy    String?
  cancelledAt    DateTime?

  member Member @relation(fields: [memberId], references: [id])

  @@index([organisationId])
  @@index([memberId])
  @@map("member_removal_requests")
}

// §8.6, FR-CLM-01 through FR-CLM-04/06 (FR-CLM-05's discretionary graded
// bands and FR-CLM-06's full sequential/parallel/threshold routing are
// explicitly out of Phase 1 per the roadmap — this is "a simple 1-2 stage
// approval chain, fixed-amount benefits" only). APPROVED and PAID are
// deliberately distinct states, mirroring Obligation vs payment (§12.4):
// a claim can clear every approval stage and still be sitting unpaid,
// which is exactly the "applications register" vs "approved-and-paid
// register" split FR-CLM-04 asks for — both are just filtered views over
// this one table, not two separate stores.
enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

// amountValue/currency are copied from the BenefitRule at submission time
// (not read live from the rule later) so an amendment to the rule after
// submission can never retroactively change what a pending claim pays out
// — the same "obligation locks its amount at creation" reasoning as
// Obligation.amountValue. dependantId is set when subjectTypes indicates
// the claim is about a dependant (e.g. "dependant.death") rather than the
// member themselves; occurrenceCap enforcement (RuleEngineService) counts
// prior claims scoped to memberId+dependantId together, so each of a
// member's dependants gets their own independent cap.
model Claim {
  id                String      @id @default(uuid())
  organisationId    String
  memberId          String
  benefitRuleId     String
  dependantId       String?
  // Usually equal to memberId, but FR-CLM-01 allows an admin to file on a
  // member's behalf — this is who actually called the endpoint.
  submittedBy       String
  eventDate         DateTime
  amountValue       Decimal     @db.Decimal(12, 2)
  currency          String
  status            ClaimStatus @default(SUBMITTED)
  // Index into benefitRule.approvalChain of the stage awaiting a decision.
  // Meaningless once status is REJECTED/PAID; frozen at the chain length
  // once APPROVED.
  currentStageIndex Int         @default(0)
  journalEntryId    String?     @unique
  createdAt         DateTime    @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id])
  member       Member             @relation(fields: [memberId], references: [id])
  benefitRule  BenefitRule        @relation(fields: [benefitRuleId], references: [id])
  dependant    Dependant?         @relation(fields: [dependantId], references: [id])
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  evidence     ClaimEvidence[]
  stageActions ClaimStageAction[]

  @@index([organisationId])
  @@index([memberId])
  @@index([benefitRuleId])
  @@map("claims")
}

// FR-CLM-01's "capturing the required evidence type." No file/blob storage
// exists in this app yet, so this is metadata-only — a type plus a text
// reference (e.g. "Death certificate #12345, held by the Secretary") — not
// the document itself. ClaimService.submit checks every type listed in the
// rule's evidenceRequired is covered by at least one row here before it
// will accept a submission.
model ClaimEvidence {
  id             String   @id @default(uuid())
  claimId        String
  organisationId String
  evidenceType   String
  description    String
  uploadedBy     String
  createdAt      DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([organisationId])
  @@index([claimId])
  @@map("claim_evidence")
}

enum ClaimDecision {
  APPROVE
  REJECT
}

// FR-CLM-03: "route through the tenant's configured approval chain,
// recording actor and timestamp" — one row per decision, at every stage,
// never overwritten. stageName is denormalized from
// benefitRule.approvalChain[stageIndex] at decision time so this row stays
// a correct historical record even in the (currently impossible, since
// BenefitRule rows are immutable versions) event that ever changes.
model ClaimStageAction {
  id             String        @id @default(uuid())
  claimId        String
  organisationId String
  stageIndex     Int
  stageName      String
  actorMemberId  String
  decision       ClaimDecision
  comment        String?
  decidedAt      DateTime      @default(now())

  claim Claim @relation(fields: [claimId], references: [id])

  @@index([organisationId])
  @@index([claimId])
  @@map("claim_stage_actions")
}

// §14, FR-DEF-01/02, Phase 1 scope only (§14.1's consistency score and
// §14.3/14.4's dumping-pattern/proportional-payout logic are explicitly
// Phase 2 per the roadmap table). One policy per tenant — opt-in: a member's
// status is never auto-transitioned unless a tenant has configured one, the
// same "some tenants don't want this" reasoning as
// Organisation.makerCheckerEnabled. defaulterThresholdMonths mirrors
// AGAOSAS's "2 consecutive months → not in good standing";
// forfeitureThresholdMonths mirrors its "3 consecutive months → forfeiture
// of entitlement" — DefaulterService maps these to the existing
// MemberStatus.DEFAULTER/SUSPENDED values rather than adding a dedicated
// "Forfeited" state Phase 1 doesn't otherwise need (both already block
// benefit eligibility identically via goodStandingRequired).
model DefaulterPolicy {
  id                        String   @id @default(uuid())
  organisationId            String   @unique
  defaulterThresholdMonths  Int
  forfeitureThresholdMonths Int
  createdAt                 DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@map("defaulter_policies")
}

// §8.11, FR-COM-01/02, Phase 1 scope only per the roadmap table (formal
// notice/read-receipt tracking for meetings, FR-COM-03, is Phase 2). No
// SMS/push/email provider account exists for this project — unlike
// Payments, nothing in the roadmap names a specific one to eventually
// integrate — so this is a real, durable in-app inbox (queryable,
// mark-as-read), not a dispatch-to-an-external-channel system. A future
// SMS/push channel would consume these same rows rather than replace them.
enum NotificationType {
  CONTRIBUTION_DUE_REMINDER
  DEFAULTER_RISK_ALERT
  CLAIM_STAGE_ENTERED
  CLAIM_STATUS_CHANGED
  SUBSCRIPTION_LAPSED
  MEMBER_JOIN_PENDING
}

// sourceType/sourceId are what makes NotificationService.notifyInTx
// idempotent — e.g. "already reminded about obligation X" — a lightweight,
// un-enforced pointer, same reasoning as JournalEntry.sourceType/sourceId.
model Notification {
  id             String           @id @default(uuid())
  organisationId String
  memberId       String
  type           NotificationType
  message        String
  sourceType     String?
  sourceId       String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([organisationId])
  @@index([memberId])
  @@map("notifications")
}

// §18, roadmap: Subscription billing, Phase 1 scope only per the roadmap
// table — free trial + one flat paid tier, operator-editable pricing
// table. The full Starter/Growth/Enterprise matrix and Federation-tier
// bundling (FR-SUB-06) are Phase 2, once more than one paid tier exists.
//
// A wholly new kind of actor, deliberately not an Account/Member: the
// platform *operator* (the SaaS company running this for many welfare
// associations) is not a member of any tenant, the same way Account
// itself is "deliberately NOT tenant-scoped" (see that model's comment) —
// just one level further out. No RLS on this table: it isn't tenant data
// at all, so there's no tenant_id to isolate on, the same reasoning
// Account gets no RLS policy. Provisioned by a one-off script
// (scripts/create-platform-operator.ts), never a self-service HTTP
// endpoint — there's no "first admin" bootstrap problem to solve here,
// just ops access.
model PlatformOperator {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_operators")
}

// FR-SUB-04: "editable by the platform operator through an admin screen,
// never hardcoded in application code." Not tenant-scoped — one shared
// catalogue every tenant picks from — so no RLS here either.
// billingCadence is free-form per §18.2 ("monthly, termly, or annual...
// not a fixed choice baked into the app"). archived (not deleted) once a
// plan is retired, so existing Subscriptions can keep referencing it —
// same "never delete, only supersede" reasoning as everywhere else rules
// are versioned in this app.
model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String
  priceAmount    Decimal  @db.Decimal(12, 2)
  currency       String
  billingCadence String
  trialDays      Int      @default(60)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// FR-SUB-01: "structurally separate from any tenant's welfare-fund
// ledger" — no relation anywhere on this model to Fund/JournalEntry/
// LedgerAccount/Obligation, by design, so platform revenue can never be
// confused with or touch a tenant's own welfare funds. Every new
// Organisation gets one of these automatically at registration
// (§18.1's "Free Trial: every new tenant, automatically"), planId null
// until they actually convert — trialDays lives on SubscriptionPlan, but
// a trial starts before any plan is chosen, so trialEndsAt is computed
// from a platform-wide default at creation, not read from a plan that
// might not exist yet.
//
// RLS here is deliberately double: the ordinary tenant_isolation policy
// (a tenant's own admin reads/manages their own subscription the normal
// way, via withTenant) *and* an independent platform-operator policy
// (SubscriptionGuard/SubscriptionService's cross-tenant management,
// via withPlatformOperatorContext) — same "Postgres ORs multiple
// permissive policies together" shape as own_memberships/
// system_scheduler_read.
model Subscription {
  id               String             @id @default(uuid())
  organisationId   String             @unique
  planId           String?
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime
  gracePeriodDays  Int                @default(14)
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}
