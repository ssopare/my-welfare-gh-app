# Copy to .env and adjust if your local infra/docker/.env uses different
# ports/passwords (e.g. POSTGRES_PORT or APP_DB_PASSWORD overrides — see
# infra/docker/README.md, including its note on the default Postgres port
# 5432 sometimes already being taken by another local service).

# Superuser connection, used only for running Prisma migrations.
DATABASE_URL="postgresql://welfare:welfare@localhost:5433/welfare_platform?schema=public"

# Restricted, non-superuser role the NestJS app actually connects as at
# runtime — created by infra/docker/initdb/01-create-app-role.sh. Must NOT
# have BYPASSRLS, or the RLS tenant-isolation policies are meaningless.
APP_DATABASE_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5433/welfare_platform?schema=public"
